<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cl.duoc.nora.cony.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Calculadora"/>

    <TextField fx:id="valor_a"/>
    <TextField fx:id="valor_b"/>

    <Button text= "Sumar" onAction="#sumar"/>
    <Button text ="Restar" onAction="#restar"/>
    <Button text ="Dividir" onAction="#dividir"/>
    <Button text= "Multiplicar" onAction="#multiplicar"/>

    <Label fx:id="resultado"/>

</VBox>
